#! /bin/bash

# Generic scripts to git-sync notebooks specified in wrangler spec; no parameters

if [[ "${GIT_SYNC_OFF:-}" == "1" ]]; then
    echo "git-sync is turned off globally.  aborting sync of notebook repos."
    exit 0
fi

yq -r '.repositories | to_entries[] | [.value.url, (.value.ref // "main")] | @tsv' \
    /opt/environments/nbw-wrangler-spec.yaml |
while IFS=$'\t' read -r repo ref; do
    out=$(basename "${repo}" | perl -p -e's/.git$//g')
    /opt/common-scripts/git-sync-v4 "${repo}" "${ref}" "${HOME}/references/${out}"
done
